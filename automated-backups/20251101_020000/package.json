{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:clean": "rm -rf node_modules/.vite .vite dist && vite --host",
    "dev:reset": "./reset-dev-server.sh",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "security:test": "node test-https-security.js",
    "security:test:domain": "node test-https-security.js",
    "ssl:setup": "chmod +x setup-ssl.sh && ./setup-ssl.sh",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "secrets:validate": "node -e \"import('./src/config/environment.js').then(env => { const validation = env.environment.validateSecrets(); if (!validation.isValid) { console.error('❌ Secrets validation failed:', validation.errors); process.exit(1); } console.log('✅ Secrets validation passed'); });\"",
    "secrets:scan": "grep -r 'sk-\\|pk_\\|AKIA\\|AIza' src/ --exclude-dir=node_modules || echo '✅ No hardcoded secrets found'",
    "secrets:report": "node -e \"import('./src/utils/secretsManager.js').then(secrets => { const report = secrets.secretsManager.generateSecurityReport(); console.log('🔐 Security Report:'); console.log('Risk Level:', report.riskLevel); console.log('Errors:', report.validation.errors.length); console.log('Warnings:', report.validation.warnings.length); });\"",
    "secrets:check": "npm run secrets:validate && npm run secrets:scan && npm run secrets:report"
  },
  "dependencies": {
