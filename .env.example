# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Cloudflare Turnstile (CAPTCHA for public signup)
# Get from Cloudflare Dashboard → Turnstile → Add Widget
VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# Note: Never commit your actual .env file with real values
# The anon key is safe to expose (it's designed to be public)
# But never expose your service_role key in frontend code
